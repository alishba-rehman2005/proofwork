# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------
# Pooled connection string used by the app at runtime.
DATABASE_URL=""

# Direct (non-pooled) connection, used for migrations.
DIRECT_URL=""

# ---------------------------------------------------------------------------
# Authentication (Auth.js)
# ---------------------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Supabase Storage (profile avatars)
# ---------------------------------------------------------------------------
# Required for avatar uploads. Without these the upload endpoint returns 503
# and the rest of the app keeps working.
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=""

# Service role key - server only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
