# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------
# Pooled connection string used by the app at runtime.
DATABASE_URL=""

# Direct (non-pooled) connection, used for migrations.
DIRECT_URL=""

# ---------------------------------------------------------------------------
# Authentication (Auth.js)
# ---------------------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""

# OAuth providers. Create one OAuth app in Google Cloud and one in GitHub,
# using /api/auth/callback/google and /api/auth/callback/github as callbacks.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---------------------------------------------------------------------------
# Supabase Storage (profile avatars)
# ---------------------------------------------------------------------------
# Required for avatar uploads. Without these the upload endpoint returns 503
# and the rest of the app keeps working.
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=""

# Service role key - server only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# Scheduled jobs. Required by /api/cron/deadlines; the route refuses to run
# without it so the endpoint cannot be triggered anonymously.
CRON_SECRET=""
